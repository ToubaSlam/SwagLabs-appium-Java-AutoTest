{
  "name": "myqapp-appium-test",
  "version": "1.0.0",
  "description": "Appium test framework for the Chamberlain myQ app (iOS and Android), using webdriverio and a Playwright-style Page Object Model.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "test": "mocha tests/**/*.test.js --timeout 120000 --require ./mocha.setup.js",
    "test:ios": "PLATFORM=ios mocha tests/**/*.test.js --timeout 120000 --require ./mocha.setup.js",
    "test:android": "PLATFORM=android mocha tests/**/*.test.js --timeout 120000 --require ./mocha.setup.js",
    "test:login": "mocha tests/login.test.js --timeout 120000 --require ./mocha.setup.js",
    "appium": "appium"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "myq",
    "mobile-automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "webdriverio": "^9.4.1",
    "appium": "^2.14.2",
    "appium-uiautomator2-driver": "^3.9.2",
    "appium-xcuitest-driver": "^7.30.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "mocha": "^10.7.3",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
